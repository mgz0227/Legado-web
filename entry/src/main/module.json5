{
  "module": {
    "name": "entry",
    "type": "entry",
    "deliveryWithInstall": true,                     // ✅ 新增
    "srcEntry": "./ets/entryability/EntryAbility.ets",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [ "phone" ],
    "requestPermissions": [
      { "name": "ohos.permission.INTERNET" }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "exported": true,
        "launchType": "standard",
        "startWindowIcon": "$media:icon",         // ✅ 新增
        "startWindowBackground": "$color:start_window_bg" // ✅ 新增
      }
    ]
  }
}
